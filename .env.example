# Copy this file to `.env` and fill in the two values from your Supabase
# project: Settings -> API.
#
# Both are safe to publish. The database is protected by the row-level
# security rules in supabase/schema.sql, not by keeping this key secret.
# The service_role key is the dangerous one — never put it in here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
